# Copy to .env. Read once at startup by launchledger/settings.py (pydantic-settings, fail fast).

# --- Database ---
POSTGRES_USER=launchledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=launchledger
# Host port for Postgres; uncommon on purpose so a local Postgres on 5432 doesn't clash.
POSTGRES_HOST_PORT=55432
# For running on the host. Inside Compose the app uses host "postgres" and port 5432.
DATABASE_URL=postgresql+psycopg://launchledger:change-me@localhost:55432/launchledger
# Separate database the E2E/integration tests reset freely. Never point this at the dev DB.
TEST_DATABASE_URL=postgresql+psycopg://launchledger:change-me@localhost:55432/launchledger_test

# --- LLM ---
# mock = scripted MockProvider (default, no key needed); openrouter = real models.
LLM_MODE=mock
# Not needed in mock mode. Set a spend limit on this key at openrouter.ai.
OPENROUTER_API_KEY=
# OpenRouter model slugs (openrouter.ai/models). Pick a model with solid tool calling for both.
# Hint: a current Claude Sonnet-class model for WORKFLOW_MODEL; a cheaper fast model is fine for ROUTER_MODEL.
WORKFLOW_MODEL=
ROUTER_MODEL=
# Second model for `ll eval compare` (stage 9), ideally from another vendor.
COMPARE_MODEL=

# --- Assistant & systems ---
# Base URL the tool layer uses to reach /systems/*. The app calls itself over HTTP.
SYSTEMS_BASE_URL=http://127.0.0.1:8000
# Fixed "today" for late-PO logic. Leave set for demos and tests; blank = real date.
FROZEN_TODAY=2026-10-01

# --- Drift ---
# Seconds between batch drift checks; 0 = scheduler off (checks only on demand).
DRIFT_MONITOR_INTERVAL_S=300
# 1 = drift injector + /api/admin/drift/* enabled (demo and tests). 0 in anything real.
DRIFT_INJECTION=1

# --- Testing ---
# 1 = /api/test/* routes enabled. Never 1 outside tests.
TEST_MODE=0
# Delay before each mock LLM reply, so "Running..." is observable. Evals always use 0.
MOCK_LATENCY_MS=150
# Where "Convert to eval case" writes draft cases.
EVAL_DRAFTS_DIR=evals/cases/drafts
# Set to 1 to run the real-model @smoke suite (needs the LLM vars above and LLM_MODE=openrouter).
RUN_SMOKE=0

# --- Server ---
# The app binds 0.0.0.0 inside Docker; Compose publishes it on 127.0.0.1 only (no login in v1).
HOST=127.0.0.1
PORT=8000
